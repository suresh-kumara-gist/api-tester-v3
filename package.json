{
    "name": "api-tester-v3",
    "version": "1.0.0",
    "description": "Postman-like API testing desktop application",
    "main": "electron/main.js",
    "author": "API Tester v3",
    "license": "MIT",
    "private": true,
    "scripts": {
      "dev": "vite",
      "build": "vite build",
      "preview": "vite preview",
      "electron:dev": "npm run build && electron electron/main.js",
      "electron:build": "npm run build && electron-builder",
      "dist": "electron-builder",
      "dist:mac": "electron-builder --mac"
    },
    "dependencies": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "zustand": "^4.4.7"
    },
    "devDependencies": {
      "@types/react": "^18.2.43",
      "@types/react-dom": "^18.2.17",
      "@vitejs/plugin-react": "^4.2.1",
      "electron": "^27.1.3",
      "electron-builder": "^24.9.1",
      "vite": "^5.0.8"
    },
    "build": {
      "appId": "com.apitester.v3",
      "productName": "API Tester v3",
      "directories": {
        "output": "release"
      },
      "files": [
        "dist/**/*",
        "electron/**/*"
      ],
      "mac": {
        "target": "dmg",
        "category": "public.app-category.developer-tools"
      },
      "dmg": {
        "title": "API Tester v3",
        "icon": "public/icon.png"
      }
    }
  }